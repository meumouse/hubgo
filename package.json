{
    "name": "hubgo",
    "private": true,
    "version": "3.0.1",
    "description": "HubGo - Gerenciamento de Frete para WooCommerce",
    "scripts": {
        "dev": "npm run dev --prefix app",
        "build": "node scripts/build.mjs",
