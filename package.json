{
    "name": "hubgo",
    "private": true,
    "version": "3.1.0",
    "description": "HubGo - Gerenciamento de Frete para WooCommerce",
    "scripts": {
        "dev": "npm run dev --prefix app",
        "build": "node scripts/build.mjs",
        "build:fast": "node scripts/build.mjs --skip-app --skip-composer --skip-translations --no-install",
        "build:translate": "node scripts/build.mjs --translate",
        "build:app": "npm run build --prefix app",
        "release": "node scripts/build.mjs",
        "pot": "npm run pot --prefix languages",
        "translate": "npm run translate --prefix languages",
        "translate:ai": "npm run translate:ai --prefix languages",
        "compile:translations": "npm run compile:mo --prefix languages && npm run compile:php --prefix languages"
    },
    "devDependencies": {
        "archiver": "^7.0.1"
    }
}
